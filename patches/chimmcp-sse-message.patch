@@ -123,15 +128,42 @@ export class McpServer {
   }
 
   async handleSseConnection(req: Request, res: Response): Promise<void> {
+    // The underlying SDK Server is a singleton reused across connections (this server
+    // only ever expects one MCP client at a time), but it throws "Already connected to
+    // a transport" if .connect() is called again without closing the old one first -
+    // and that throw was happening inside an unawaited promise chain, so it surfaced as
+    // an unhandled rejection that took the whole process down. A client reconnecting
+    // (e.g. after the host's own retry/the owner re-running /mcp) must replace the old
+    // session cleanly instead of crashing the server.
+    if (this.activeTransport) {
+      try {
+        await this.server.close();
+      } catch {
+        // already closed/closing - fine, we're about to connect fresh below
+      }
+      this.activeTransport = null;
+    }
     const transport = new SSEServerTransport('/message', res);
+    this.activeTransport = transport;
     await this.server.connect(transport);
 
     // Handle client disconnection
     req.on('close', () => {
       transport.close();
+      if (this.activeTransport === transport) {
+        this.activeTransport = null;
+      }
     });
   }
 
+  async handlePostMessage(req: Request, res: Response): Promise<void> {
+    if (!this.activeTransport) {
+      res.status(503).json({ error: 'No active SSE session - connect to /sse first' });
+      return;
+    }
+    await this.activeTransport.handlePostMessage(req, res, req.body);
+  }
+
   getServer(): Server {
     return this.server;
   }
