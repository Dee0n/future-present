+  // MCP client -> server messages for the active SSE session. The SDK's
+  // SSEServerTransport tells the client to POST here ('/message'), but this route
+  // never existed before, so every tool call 404'd right after the handshake.
+  router.post('/message', async (req: Request, res: Response) => {
+    await mcpServer.handlePostMessage(req, res);
+  });
+
   return router;
