+
+// TES-Speech-Adapter: plugins declare their own gameplay tables in ext/<name>/playthrough_tables.txt (one per line,
+// "#" comments), so a Playthrough Save carries them too and an older save brings no "memories of the future".
+function pts_ext_playthrough_tables(): array {
+    static $cache = null;
+    if ($cache !== null) return $cache;
+    $cache = [];
+    foreach (glob(dirname(__DIR__) . '/ext/*/playthrough_tables.txt') ?: [] as $file) {
+        foreach (file($file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
+            $t = trim(preg_replace('/#.*$/', '', $line));
+            if ($t !== '' && preg_match('/^[a-z_][a-z0-9_]*$/D', $t)) $cache[] = $t;
+        }
+    }
+    return $cache;
 }
 
